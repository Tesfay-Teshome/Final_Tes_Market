# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control!

# ===== Django Core =====
# Generate a new secret key for production using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-new-one

# Set to True only in development, False in production
DEBUG=False

# Comma-separated list of allowed hosts
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Database =====
# SQLite (default)
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/tesmarket

# MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/tesmarket

# ===== Payment Gateway (Stripe) =====
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_TEST_MODE=true

# ===== AI Integration (Google Gemini) =====
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ===== CORS Configuration =====
# Comma-separated list of allowed origins for CORS
# Development example:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===== CSRF Trusted Origins =====
# Comma-separated list of trusted origins for CSRF
# Should match your frontend URLs
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===== Optional: Email Configuration =====
# For production email sending (uncomment and configure as needed)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ===== Optional: Redis Configuration =====
# For production caching and Channels (WebSocket)
# REDIS_URL=redis://localhost:6379/0

# ===== Optional: AWS S3 Configuration =====
# For media file storage in production
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# ===== Security Notes =====
# 1. Never commit the .env file to version control
# 2. Use strong random values for SECRET_KEY
# 3. Set DEBUG=False in production
# 4. Update ALLOWED_HOSTS with your actual domain
# 5. Use HTTPS in production (enforce via SECURE_SSL_REDIRECT)
# 6. Regularly rotate sensitive credentials
